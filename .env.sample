
# VITE_NETWORK=mainnet
VITE_NETWORK=amoy

VITE_PRIVATE_IMAGE_URL=https://sunflower-land.com/testnet-assets
VITE_MINIGAMES_API_URL=https://economies-api.sunflower-land.com

# Sunflower Land Community API key (https://sunflower-land.com/community-docs/).
#
# NOT a VITE_ variable on purpose: Vite inlines every VITE_* value into the
# shipped bundle, which would hand this credential to every visitor. It is read
# only by scripts/build-vip-index.mjs, which runs in GitHub Actions where the
# same value lives as the COMMUNITY_API_KEY repository secret.
#
# Set it here only to build the VIP index locally:
#   COMMUNITY_API_KEY=... node scripts/build-vip-index.mjs
COMMUNITY_API_KEY=

# Optional: where the arcade reads the published VIP index from. Defaults to the
# vip-data branch of this repo, served by raw.githubusercontent.com (which sends
# Access-Control-Allow-Origin: *, so no allow-listing is needed).
# VITE_VIP_INDEX_URL=

