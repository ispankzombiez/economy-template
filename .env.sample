
# VITE_NETWORK=mainnet
VITE_NETWORK=amoy

VITE_PRIVATE_IMAGE_URL=https://sunflower-land.com/testnet-assets
VITE_MINIGAMES_API_URL=https://economies-api.sunflower-land.com

# Sunflower Land Community API key (https://sunflower-land.com/community-docs/).
# Read only as a fallback for farm.vip, and only when this is set.
#
# WARNING: this is a VITE_ variable, so Vite inlines it into the built bundle and
# anyone who opens the deployed site can read it. It is a shared credential, not a
# private secret. Rotate it at sunflower-land.com if that matters to you.
VITE_SUNFLOWER_COMMUNITY_API_KEY=

